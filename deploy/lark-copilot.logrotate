# lark-copilot 日志切割
#
# 安装：
#   sudo cp deploy/lark-copilot.logrotate /etc/logrotate.d/lark-copilot
#   sudo logrotate -d /etc/logrotate.d/lark-copilot   # dry-run 验证
#
# 触发：logrotate 默认每天由 /etc/cron.daily/logrotate 跑一次。
#
# copytruncate 而不是常规的 create + reopen：systemd StandardOutput=append:PATH
# 持有文件 fd，rotate 后老 fd 还指向被 mv 走的 inode（会继续写到 .1 文件里）。
# 用 copytruncate 把文件原地拷一份再 truncate(0)，进程 fd 继续指向同一 inode，
# 无需 reload 服务。代价是切割瞬间可能丢极少量字节（写在 cp 和 truncate 之间）。
#
# 想避免那点小风险，可以改成 postrotate 里 systemctl restart lark-copilot，
# 但代价大得多。

/var/log/lark-copilot/router.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su lark-copilot lark-copilot
}
