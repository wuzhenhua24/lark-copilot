# --- Behavior ---
# 1 = log only, never send ack envelope (use this for first run)
DRY_RUN=1

# --- Agent-to-agent collab ---
# 受信任的 peer agent open_id（逗号分隔）。发结构化 envelope，走 envelope 路径。
# 典型：ops-qa-bot 的 bot open_id。
COLLAB_SENDERS=

# --- Human DM / 群聊 @bot 模式 ---
# 真人用户 open_id 白名单（逗号分隔）。这些 open_id 可以直接 DM 本 bot 一段
# 自然语言（飞书 URL + 问题），bot 会拉文档跑 QA 后以纯文本回复。
# 群聊里也是同一份白名单：群里 @bot 的发送者必须在此名单里才会触发。
#
# 群聊的 "只在 @ 时响应" 由飞书 scope 兜底（im:message.group_at_msg:readonly
# 决定 bot 在群里只收到 @ 自己的事件，没勾更宽的 group_msg:readonly 就拿不到
# 别的）。代码层不做 mentions 匹配。
#
# 怎么知道自己的 open_id：用任一真人飞书账号 DM bot 一条消息，看 router 日志
# 里 `skip_untrusted_sender` 这行的 sender 字段，复制过来即可。
HUMAN_SENDERS=

# 拉文档（lark-cli docs +fetch）的硬超时，秒。通常 1-3 秒，30 已经很宽裕，主要兜底网络抖。
DOC_FETCH_TIMEOUT_SEC=30
# 单轮模型推理的硬超时，秒。含 tool round-trip（fetch_doc_image 拉图 + 看图再答）。
# 多图问题或文档很长时容易吃满 30+ 秒，建议留 120 以上；按需上调。
INFERENCE_TIMEOUT_SEC=120

# Human 模式：同一 chat 多少分钟没活动后丢弃会话状态（client + 文档缓存）
SESSION_TTL_MIN=30

# Human 模式：每个用户问题里 Claude 最多通过 fetch_doc_image 工具拉几张图。
# 文档里的图以 <image idx="N"/> 占位形式给到模型，模型按需调用工具实拉图片字节。
# 拉图走 vision token 比纯文本贵很多，且 latency 涨；这个上限是软策略。
MAX_IMAGES_PER_QUESTION=3

# --- HTTP API (http_api.py) ---
# 给同内网的 peer agent 直接 HTTP 调用的 doc QA 接口（替代 envelope-over-IM 中继）。
# 跟 router.py 互不相干，可同机各跑一个 systemd unit。复用 DOC_FETCH_TIMEOUT_SEC /
# INFERENCE_TIMEOUT_SEC / MAX_IMAGES_PER_QUESTION（同上）。
#
# 监听地址/端口。默认只听 127.0.0.1；跨机调用时按内网可达性改成 0.0.0.0 或具体网卡 IP。
HTTP_HOST=127.0.0.1
HTTP_PORT=8800
# 鉴权 token：设了就要求调用方带 `Authorization: Bearer <token>`；留空则放行（仅内网测试）。
# 上线务必配上。生成示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
HTTP_API_TOKEN=

# --- Paths ---
LARK_CLI=lark-cli

# 部分网络下 lark-cli 通过 https_proxy 走 `docs +media-download` 会 TLS handshake
# timeout（内部走 open.feishu.cn/open-apis/drive/v1/medias/... 二进制流）。
# 现象：图片下载失败，但 `docs +fetch` 文本走得通。这种情况下取消注释下行让
# 媒体下载绕过代理（其它 lark-cli 命令也会绕，按需）。
# LARK_CLI_NO_PROXY=1

# --- Required lark-cli scopes ---
# 应用身份（飞书后台「权限管理 → 应用身份权限」勾选）：
#   im:message.p2p_msg:readonly -> bot 接收 DM 的 im.message.receive_v1 事件
#   im:message.group_at_msg:readonly -> bot 接收群里 @ 自己的 im.message.receive_v1 事件
#   im:message:send             -> bot 发 ack envelope / 群里 +messages-reply 引用回复
# 用户身份（通过 `lark-cli auth login --scope ...` 授权给登录 user）：
#   docx:document:readonly      -> lark-cli docs +fetch 拉飞书文档
#   drive:drive:readonly (可选)  -> 搜云空间文档

# 模型不在此选 —— 整个项目复用部署机 Claude Code 的固定第三方模型。
