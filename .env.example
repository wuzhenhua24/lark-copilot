# --- Required: where to redirect people ---
GROUP_NAME=测试环境支持群
GROUP_BOT_NAME=测试环境助手
GROUP_LINK=https://applink.feishu.cn/client/chat/chatter/add_by_link?link_token=REPLACE_ME

# --- Behavior ---
# 1 = log only, never send (use this for first run)
DRY_RUN=1
# Don't redirect the same person again within N hours
COOLDOWN_HOURS=24
# Note: 模型不在此选 —— 整个项目复用部署机 Claude Code 的固定第三方模型。

# --- Optional sender filters (comma-separated open_id) ---
# If set, ONLY these senders get classified+redirected (good for first-week pilot)
ONLY_SENDERS=
# Senders to never auto-reply to (boss, family, etc.)
SKIP_SENDERS=

# --- Paths ---
LARK_CLI=lark-cli
STATE_FILE=.state/cooldown.json

# --- Agent-to-agent collab (ops-qa-bot 等协作机器人) ---
# 受信任的 peer agent open_id（逗号分隔），命中后跳过 TEST_ENV 分类，
# 直接走 agent_collab.handle_doc_qa（doc_qa envelope）。
COLLAB_SENDERS=
# 一次 doc_qa（拉文档 + 推理）的总超时，秒
DOC_QA_TIMEOUT_SEC=55

# --- Required Lark scopes (granted via `lark-cli auth login --scope ...`) ---
# im:message              -> receive im.message.receive_v1 as user
# im:message:send_as_user -> reply in DM as you
# contact:user.base:readonly (optional) -> resolve sender open_id -> name in logs
# docx:document:readonly  -> lark-cli docs +fetch（agent_collab 拉飞书文档）
# drive:drive:readonly    -> 搜云空间文档（按需）
