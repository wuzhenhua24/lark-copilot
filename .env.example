# --- Behavior ---
# 1 = log only, never send ack envelope (use this for first run)
DRY_RUN=1

# --- Agent-to-agent collab ---
# 受信任的 peer agent open_id（逗号分隔）。发结构化 envelope，走 envelope 路径。
# 典型：ops-qa-bot 的 bot open_id。
COLLAB_SENDERS=

# --- Human DM mode ---
# 真人用户 open_id 白名单（逗号分隔）。这些 open_id 可以直接 DM 本 bot 一段
# 自然语言（飞书 URL + 问题），bot 会拉文档跑 QA 后以纯文本回复。
#
# 怎么知道自己的 open_id：用任一真人飞书账号 DM bot 一条消息，看 router 日志
# 里 `skip_untrusted_sender` 这行的 sender 字段，复制过来即可。
HUMAN_SENDERS=

# 一次 doc_qa（拉文档 + 推理）的总超时，秒。两个路径共用，内部按 40/60 切给 fetch 和推理。
DOC_QA_TIMEOUT_SEC=55

# Human 模式：同一 chat 多少分钟没活动后丢弃会话状态（client + 文档缓存）
SESSION_TTL_MIN=30

# --- Paths ---
LARK_CLI=lark-cli

# --- Required lark-cli scopes ---
# 应用身份（飞书后台「权限管理 → 应用身份权限」勾选）：
#   im:message.p2p_msg:readonly -> bot 接收 im.message.receive_v1 事件
#   im:message:send             -> bot 发 ack envelope
# 用户身份（通过 `lark-cli auth login --scope ...` 授权给登录 user）：
#   docx:document:readonly      -> lark-cli docs +fetch 拉飞书文档
#   drive:drive:readonly (可选)  -> 搜云空间文档

# 模型不在此选 —— 整个项目复用部署机 Claude Code 的固定第三方模型。
